#!/bin/sh
# SPDX-License-Identifier: BSD-2-Clause
#
# usage: n2s-run start | stop | reload | foreground
#
# Starts or stops both nginx instances of the demo image: 1.31.8 on 8443
# and 1.31.9 on 9443. start leaves both as daemons (the chroot on a
# target); foreground keeps 1.31.9 in the foreground (docker run).

set -eu

VULN=/usr/sbin/nginx
PATCHED=/usr/local/sbin/nginx
VULN_CONF=/etc/nginx/n2s/vulnerable.conf
PATCHED_CONF=/etc/nginx/n2s/patched.conf

case ${1:-} in
start)
	"$VULN" -c "$VULN_CONF"
	"$PATCHED" -c "$PATCHED_CONF"
	;;
stop)
	"$VULN" -c "$VULN_CONF" -s quit 2>/dev/null || :
	"$PATCHED" -c "$PATCHED_CONF" -s quit 2>/dev/null || :
	;;
reload)
	"$VULN" -c "$VULN_CONF" -s reload
	"$PATCHED" -c "$PATCHED_CONF" -s reload
	;;
foreground)
	"$VULN" -c "$VULN_CONF"
	exec "$PATCHED" -c "$PATCHED_CONF" -g 'daemon off;'
	;;
*)
	echo "usage: $0 start | stop | reload | foreground" >&2
	exit 2
	;;
esac
